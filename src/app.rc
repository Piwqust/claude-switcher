#include <winres.h>
#include "version.h"
#pragma code_page(65001)

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CPS_VERSION_NUM
 PRODUCTVERSION CPS_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Claude Profile Switcher"
      VALUE "ProductName", "Claude Profile Switcher"
      VALUE "FileVersion", CPS_VERSION_TEXT
      VALUE "ProductVersion", CPS_VERSION_TEXT
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "ClaudeProfileSwitcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
