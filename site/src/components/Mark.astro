---
// The site's mark: three account windows standing side by side.
interface Props { size?: number; class?: string }
const { size = 22, class: cls } = Astro.props;
---
<svg class:list={['mark', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="1" y="3" width="6.6" height="18" rx="2" fill="#e08a6b" />
  <rect x="8.7" y="3" width="6.6" height="18" rx="2" fill="#5596c4" />
  <rect x="16.4" y="3" width="6.6" height="18" rx="2" fill="#5fa872" />
</svg>
